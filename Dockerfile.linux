FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
RUN apt update
RUN apt install -y curl
COPY out /app
RUN mkdir -p /smtp4dev && chown -R app:app /smtp4dev
VOLUME ["/smtp4dev"]
WORKDIR /
ENV XDG_CONFIG_HOME /
ENV ASPNETCORE_HTTP_PORTS 80
ENV SERVEROPTIONS__URLS http://*:80
ENV DOTNET_USE_POLLING_FILE_WATCHER true
# Web UI and API
EXPOSE 80
# SMTP submission: STARTTLS, implicit TLS, STARTTLS
EXPOSE 587
EXPOSE 465
EXPOSE 2525
# SMTP, for configurations which still serve it
EXPOSE 25
# IMAP: STARTTLS and implicit TLS
EXPOSE 143
EXPOSE 993
# POP3: STARTTLS and implicit TLS
EXPOSE 110
EXPOSE 995
ENTRYPOINT ["dotnet", "/app/Rnwood.Smtp4dev.dll"]
